# All of these are optional. The app runs with none of them set.

# Enables the pgvector backend instead of the in-memory index.
DATABASE_URL=postgresql://darukaa:darukaa@localhost:5432/darukaa

# Set to 0 to force the hashed encoder and skip the model download.
USE_ST_EMBEDDINGS=1
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional. Only used to rephrase recommendations that have already been chosen.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

CORS_ORIGINS=*
